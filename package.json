{
  "name": "llmscope",
  "version": "0.1.0",
  "description": "Deterministic LLM bias eval harness: swap identity variables in a prompt, run across models via OpenRouter (bring your own key), measure refusals, keywords, length and sentiment, and render a shareable card.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Christian-von-Uffel/llmscope.git"
  },
  "homepage": "https://github.com/Christian-von-Uffel/llmscope#readme",
  "bugs": {
    "url": "https://github.com/Christian-von-Uffel/llmscope/issues"
  },
  "keywords": [
    "llm",
    "bias",
    "eval",
    "fairness",
    "openrouter",
    "refusal",
    "benchmark",
    "ai-safety"
  ],
  "files": [
    "bin/",
    "src/",
    "web/",
    "assets/",
    "examples/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "llmscope": "bin/llmscope.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "assets": "node scripts/build-site-assets.mjs",
    "dev": "npm run assets && astro dev",
    "build": "npm run assets && astro build",
    "preview": "astro preview",
    "prepare": "[ -n \"$CI\" ] || npm run build || echo 'llmscope: the website did not build, so llmscope serve has nothing to serve. The CLI itself is unaffected.'",
    "serve": "node bin/llmscope.js serve --port 5173",
    "api": "wrangler dev --port 8787",
    "db": "wrangler d1 migrations apply llmscope --local",
    "db:remote": "wrangler d1 migrations apply llmscope --remote",
    "deploy": "npm run build && wrangler deploy",
    "demo": "node bin/llmscope.js run examples/identity-swap.json --provider mock --yes",
    "start": "node bin/llmscope.js"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.9",
    "@inquirer/prompts": "^8.7.1",
    "@napi-rs/canvas": "^1.0.8",
    "dejavu-fonts-ttf": "^2.37.3",
    "sentiment": "^5.0.2"
  },
  "devDependencies": {
    "@lobehub/icons-static-svg": "^1.95.0",
    "astro": "^7.3.2",
    "wrangler": "^4.131.1"
  }
}
