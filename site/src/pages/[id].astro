---
// llmscope.dev/<id>: the address every card prints in its footer. See site/src/lib/eval-page.js.
import Site from '../layouts/Site.astro';
import { evalPaths, describeEval } from '../lib/eval-page.js';

export const getStaticPaths = evalPaths;

const { id } = Astro.params;
const { spec, noun } = Astro.props;
---
<Site title={`llmscope · ${noun} ${id}`} description={describeEval(spec)} />
