---
// llmscope.dev/e/<id>: the address earlier cards printed, kept so they go on opening. See site/src/lib/eval-page.js.
import Site from '../../layouts/Site.astro';
import { evalPaths, describeEval } from '../../lib/eval-page.js';

export const getStaticPaths = evalPaths;

const { id } = Astro.params;
const { spec } = Astro.props;
---
<Site title={`llmscope · eval ${id}`} description={describeEval(spec)} />
